# Normalize to LF in the repository (Windows checkouts may still use CRLF locally)
* text=auto eol=lf

*.swift   text eol=lf
*.py      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.plist   text eol=lf
*.md      text eol=lf
*.sh      text eol=lf

*.png     binary
*.jpg     binary
*.ipa     binary
*.zip     binary
